# SafeHer Backend Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB Connection
# Default local: mongodb://localhost:27017/safeher
MONGO_URI=mongodb://localhost:27017/safeher

# Twilio Configuration (Optional for SMS/Voice)
# Sign up at https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
